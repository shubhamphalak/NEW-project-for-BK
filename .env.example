# Adding a key does not change mode. For live use LLM_ENABLED=true and MOCK_LLM_MODE=false.
# Keep this file private. Restart the server after changing configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
LLM_ENABLED=true
MOCK_LLM_MODE=true
LLM_MAX_OUTPUT_TOKENS=800
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_MS=20000
LLM_HISTORY_TURNS=6
LLM_CONTEXT_MAX_CHARS=8000
LLM_INPUT_TOKEN_BUDGET=6000
LLM_MAX_TOOL_ROUNDS=3
LLM_MAX_TOOL_CALLS=6
PORT=4173
# Optional prices in USD per one million tokens; blank means cost unknown.
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=
# Optional local verified-provider / aggregated analytics JSON files.
MARKET_DATA_FILE=
ANALYTICS_DATA_FILE=

# Optional server-only temporary login overrides; blank uses backend defaults.
ART_LOGIN_USERNAME=
ART_LOGIN_PASSWORD=

# Local default; Docker run overrides HOST to 0.0.0.0.
HOST=127.0.0.1
# Optional public origin when deploying behind a domain / HTTPS reverse proxy.
# Example: APP_ORIGIN=https://himaya.example.com
APP_ORIGIN=
